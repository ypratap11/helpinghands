# Production environment for the docker-compose.prod.yml stack.
#
# Copy this file to `.env.production` on the droplet, fill in real values,
# and never commit that file. `.env.production` is already gitignored
# (matched by the `.env*` rule in .gitignore).
#
#   cp .env.production.example .env.production

# Full connection string the app uses at runtime. Host is "db" (the compose
# service name, not localhost - the app reaches Postgres over the private
# compose network), and the password must be IDENTICAL to POSTGRES_PASSWORD
# below (Postgres itself only reads POSTGRES_PASSWORD; nothing keeps the two
# in sync automatically, so update both together).
DATABASE_URL="postgresql://helping:CHANGE_ME_MATCH_POSTGRES_PASSWORD@db:5432/helping_hands?schema=public"

# Auth.js session/JWT signing secret. Generate a fresh one for production,
# e.g.: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth client ID (same Google Cloud OAuth client used for local dev;
# https://helpinghands.augaster.com/api/auth/callback/google must already be
# a registered redirect URI on it).
AUTH_GOOGLE_ID=""

# Google OAuth client secret, paired with AUTH_GOOGLE_ID above.
AUTH_GOOGLE_SECRET=""

# Public base URL of the deployed site. Auth.js uses this to build the
# OAuth callback/redirect URLs - it must exactly match the domain Caddy
# terminates TLS for.
NEXTAUTH_URL="https://helpinghands.augaster.com"

# Required for self-hosted Auth.js v5 behind our own reverse proxy (Caddy).
# Auth.js only trusts the incoming request's Host header automatically on
# Vercel/Cloudflare Pages, or when NODE_ENV isn't "production" - everywhere
# else (including here) it refuses every request with an "UntrustedHost"
# error unless this is set, even when the Host header already matches
# NEXTAUTH_URL exactly. Verified locally: sign-in is broken without it.
AUTH_TRUST_HOST="true"

# Comma-separated list of email addresses granted the ADMIN role the first
# time they sign in (see resolveRoleForEmail in src/lib/auth-roles.ts).
ADMIN_EMAILS=""

# Password for the `helping` Postgres role, used by the `db` service itself.
# Must match the password embedded in DATABASE_URL above. Generate with
# e.g.: openssl rand -hex 24
POSTGRES_PASSWORD=""

# The group's timezone. The app already handles Asia/Kolkata correctly in
# application code regardless of the server/container's own clock (which
# runs UTC) - this variable does not change that; it is not currently read
# by the app, but is documented here per the deployment spec so it is not
# silently missing if that changes.
TZ="Asia/Kolkata"
